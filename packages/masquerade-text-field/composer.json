{
    "name": "flaiming/flarum-masquerade-text-field",
    "description": "Adds a multi-line formatted text field type to FoF Masquerade profiles.",
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Vojtěch Oram",
            "homepage": "https://vojtechoram.cz"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-xsl": "*",
        "flarum/core": "^2.0",
        "fof/masquerade": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Flaiming\\MasqueradeTextField\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Masquerade Text Field",
            "category": "feature",
            "icon": {
                "name": "fas fa-align-left",
                "backgroundColor": "#9b4a3e",
                "color": "#fff"
            }
        }
    }
}
